#include "res.h"

#ifndef APSTUDIO_INVOKED
#include "SDKDDKVer.h"
#endif
#include "windows.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

/////////////////////////////////////////////////////////////////////////////
// Icon

IDI_APP ICON "app.ico"

/////////////////////////////////////////////////////////////////////////////
// Menu

IDC_APP MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Record clip",                IDM_RECORD
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Face &detect",                IDM_FACEDETECT
        MENUITEM "Face &landmarking",           IDM_FACELANDMARK
        MENUITEM "Landmark &overlay",           IDM_LANDMARKOVERLAY
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END

/////////////////////////////////////////////////////////////////////////////
// Dialog

IDD_ABOUTBOX DIALOGEX 0, 0, 200, 68
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About low-ban"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            IDI_APP,IDC_STATIC,14,14,21,20
    LTEXT           "low-ban - low bandwidth video experiment",IDC_STATIC,42,14,150,8,SS_NOPREFIX
    LTEXT           "Landmark-warped codec against H.264.",IDC_STATIC,42,26,150,8
    DEFPUSHBUTTON   "OK",IDOK,143,47,50,14,WS_GROUP
END

/////////////////////////////////////////////////////////////////////////////
// String Table

STRINGTABLE
BEGIN
    IDC_APP         "LowBanWindowClass"
    IDS_APP_TITLE   "low-ban"
END
